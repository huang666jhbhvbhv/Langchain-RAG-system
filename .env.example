# Chat model (application-local .env; process environment takes precedence)
LLM_API_KEY=YOUR_DEEPSEEK_API_KEY
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=90
LLM_MAX_TOKENS=2048
# local: requires requirements-local.txt and first-run model download.
# openai: separate OpenAI-compatible Embeddings provider (NOT a chat endpoint).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# For a gateway with OpenAI-compatible embeddings, set its actual embedding model above.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CONTEXT_CHARS=10000
# Similarity gate is model-dependent; calibrate using your evaluation set.
MIN_COSINE=0.25
MIN_BM25=0.1
